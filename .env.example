# Kalshi API Configuration
# Copy this file to .env and fill in your credentials

# Your Kalshi API key ID (from Settings -> API in Kalshi dashboard)
KALSHI_API_KEY_ID=your-api-key-id-here

# Path to your RSA private key file (PEM format)
KALSHI_PRIVATE_KEY_PATH=/path/to/your/private_key.pem

# Set to 'true' to use demo API (optional)
KALSHI_DEMO_MODE=false
